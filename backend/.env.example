# AI Software Team - Environment Variables Example
# Duplicate this file to .env and fill in your free keys

# LLM Provider Keys (100% Free Tiers)
# 1. Groq: Get free key at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 2. Google Gemini: Get free key at https://aistudio.google.com
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 3. OpenRouter (Fallback): Get free key at https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Supabase (Database, Auth, Storage) - Free at https://supabase.com
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# GitHub Integration (Optional - for pushing code directly to user repos)
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# App Settings
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
WORKSPACE_DIR=./workspace
MAX_REVIEW_LOOPS=2
CONCURRENCY_LIMIT=2
